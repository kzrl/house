# Home Monitoring System Environment Variables

# Ecowitt weather station URL
# Example: http://192.168.1.10 or http://weather
ECOWITT_URL=http://weather

# Awair air quality monitor hosts
# Format: host=location or just host (uses host as location)
# Multiple devices: host1=location1,host2=location2
# Example: 192.168.1.11=office,192.168.1.12=bedroom
AWAIR_HOSTS=

# Daikin air conditioner URL
# Example: http://192.168.1.62
DAIKIN_URL=

# Fronius solar inverter URL (optional)
# Example: http://192.168.1.50 or http://froniuslan
FRONIUS_URL=

# Port for the metrics server (default: 8080)
PORT=8080
